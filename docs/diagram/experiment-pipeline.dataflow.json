  "cards": [
    {
      "dot": "emerald",
      "title": "One request shape, five marker placements",
      "items": [
        "Every arm sends instructions, the story and one question in the same order; only the cache_control marker moves",
        "A: no marker. B: top-level automatic. C: on the story block. D: like C with a timestamp above it. E: on the question block",
        "Each (arm, rep) pair embeds its own tag in the instructions so arms never read each other's cache entries"
      ]
    },
    {
      "dot": "amber",
      "title": "Guards in the harness",
      "items": [
        "Asserts the story block is byte-identical to the frozen row before every request",
        "Appends to results/rep<N>.csv, skips rows already done, retries rows with errors, stops on billing or auth errors",
        "Sonnet 5.5 rejects temperature; thinking is pinned off with between_tools in config.json for every arm"
      ]
    },
    {
      "dot": "violet",
      "title": "Pre-registered checks",
      "items": [
        "Six criteria live in analyze.py::checks and are not moved after a run",
        "Accuracy is re-scored from raw answers with the current parser so old and new rows agree",
        "Run of 17 Oct 2026, arms A and C: hit ratio 0.989, cost multiplier 0.110, all six checks passed"
      ]
    }
  ]
